SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Google Calendar — ปิดไว้ก่อนได้ เชื่อมทีหลังได้ (true เมื่อพร้อมใช้ OAuth)
ENABLE_GOOGLE_CALENDAR=false

# Google Calendar (OAuth — เปิด Calendar API + สร้าง OAuth Client แบบ Web ใน Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL ต้องตรงกับ Authorized redirect URIs ใน Console (มีท้าย / ตามที่ลงทะเบียน)
# ตัวอย่าง local: http://localhost:8501/
# ตัวอย่าง Streamlit Cloud: https://your-app.streamlit.app/
GOOGLE_REDIRECT_URI=http://localhost:8501/

# AI วางแผน (Gemini) — ไม่ใส่จะเป็นตัวอย่างในหน้า AI
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
